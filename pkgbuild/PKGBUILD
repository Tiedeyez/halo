pkgname=halo
pkgver=0.1.0
pkgrel=1
pkgdesc='A music player for Omarchy: your library, mixed like a DJ would'
arch=('x86_64' 'aarch64')
license=('MIT' 'CC-BY-SA-4.0')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'taglib' 'ffmpeg')
makedepends=('gcc' 'make' 'qt6-shadertools')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/halo "$pkgdir/usr/bin/halo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/data/HEADPHONES-LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/HEADPHONES-LICENSE.md"
  install -Dm644 "$startdir/halo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/halo.svg"
  install -Dm644 "$startdir/halo.desktop" "$pkgdir/usr/share/applications/halo.desktop"
}
