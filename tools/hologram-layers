#!/bin/sh
# Packs the Hologram visual's light layers, rendered by
# art/turntable/turntable.py --energy, into the app's resources
# (src/hologram): grey WebP on black (light, added by the app), the lines
# at SIZE and the soft body glow at half, the moving parts cropped to the
# area they ever cover.
#
#   tools/hologram-layers ENERGY_DIR [SIZE]
#
# Needs ImageMagick (magick) and python3.
set -eu

IN="${1:?usage: tools/hologram-layers ENERGY_DIR [SIZE]}"
SIZE="${2:-1536}"
HALF=$((SIZE / 2))
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
OUT="$ROOT/src/hologram"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

mkdir -p "$OUT"
rm -f "$OUT"/*.webp "$OUT"/manifest.json "$OUT"/manifest.js "$OUT"/hologram.qrc

# Every pass as grey light on black, at SIZE.
for f in "$IN"/energy-*.png; do
    magick "$f" -background black -alpha remove -alpha off -colorspace Gray -resize "${SIZE}x${SIZE}" \
        "$WORK/$(basename "$f" .png | sed 's/^energy-//').png"
done

box() { # x y w h of everything lit in the given images, padded
    for f in "$@"; do
        magick "$f" -threshold 2% -format "%@\n" info:
    done | awk -F'[x+]' '
        { x0 = $3; y0 = $4; x1 = $3 + $1; y1 = $4 + $2
          if (NR == 1 || x0 < X0) X0 = x0; if (NR == 1 || y0 < Y0) Y0 = y0
          if (NR == 1 || x1 > X1) X1 = x1; if (NR == 1 || y1 > Y1) Y1 = y1 }
        END { pad = 24; X0 -= pad; Y0 -= pad; X1 += pad; Y1 += pad
              if (X0 < 0) X0 = 0; if (Y0 < 0) Y0 = 0
              X0 -= X0 % 2; Y0 -= Y0 % 2; W = X1 - X0; H = Y1 - Y0; W += W % 2; H += H % 2
              print X0, Y0, W, H }'
}

# pack NAME X Y W H: lines at full size, body at half, both cropped.
pack() {
    magick "$WORK/$1-lines.png" -crop "${4}x${5}+${2}+${3}" +repage -quality 90 "$OUT/$1-lines.webp"
    magick "$WORK/$1-body.png" -crop "${4}x${5}+${2}+${3}" +repage -resize 50% -quality 85 "$OUT/$1-body.webp"
}

pack deck 0 0 "$SIZE" "$SIZE"
set -- $(box "$WORK"/arm-*-lines.png "$WORK"/arm-*-body.png)
AX=$1 AY=$2 AW=$3 AH=$4
for f in "$WORK"/arm-*-lines.png; do
    pack "$(basename "$f" -lines.png)" "$AX" "$AY" "$AW" "$AH"
done
set -- $(box "$WORK"/spindle-lines.png "$WORK"/spindle-body.png)
SX=$1 SY=$2 SW=$3 SH=$4
pack spindle "$SX" "$SY" "$SW" "$SH"
# The controls the app moves (the gain dial's index turns, the fader
# slides), if this render has them.
CONTROLS=""
for c in dial fader; do
    [ -f "$WORK/$c-lines.png" ] || continue
    set -- $(box "$WORK/$c-lines.png" "$WORK/$c-body.png")
    pack "$c" "$1" "$2" "$3" "$4"
    CONTROLS="$CONTROLS $c:$1,$2,$3,$4"
done

python3 -I - "$IN/manifest.json" "$OUT/manifest.json" "$SIZE" "$AX" "$AY" "$AW" "$AH" "$SX" "$SY" "$SW" "$SH" "$CONTROLS" "$IN/controls.json" <<'PY'
import json, os, sys
src, dst, size, ax, ay, aw, ah, sx, sy, sw, sh, controls, controlsJson = sys.argv[1:]
m = json.load(open(src))
m["image"] = int(size)
m["frames"] = len(m["headings"])
m["arm"] = {"x": int(ax), "y": int(ay), "w": int(aw), "h": int(ah)}
m["spindle"] = {"x": int(sx), "y": int(sy), "w": int(sw), "h": int(sh)}
# The moving controls (packed pixels) and the lit ones (image fractions).
if controls.strip() and os.path.exists(controlsJson):
    where = json.load(open(controlsJson))
    s = int(size)
    for item in controls.split():
        name, box = item.split(":")
        x, y, w, h = map(int, box.split(","))
        m[name] = {"x": x, "y": y, "w": w, "h": h}
    if "dial" in m:
        m["dial"]["cx"], m["dial"]["cy"] = where["dialCentre"][0] * s, where["dialCentre"][1] * s
    if "fader" in m:
        m["fader"]["rest"] = where["faderRest"][1] * s
        m["fader"]["low"] = where["faderLow"][1] * s
        m["fader"]["high"] = where["faderHigh"][1] * s
    cx, cy = where["start"]
    m["start"] = {"x": cx, "y": cy, "w": 2 * abs(where["startCorner"][0] - cx), "h": 2 * abs(where["startCorner"][1] - cy)}
    m["pip"] = {"x": where["pip"][0], "y": where["pip"][1]}
json.dump(m, open(dst, "w"), indent=1)
with open(dst[:-len("manifest.json")] + "manifest.js", "w") as f:
    f.write(".pragma library\n// Written by tools/hologram-layers; see manifest.json.\nvar data = " + json.dumps(m) + ";\n")
PY

{
    echo '<RCC>'
    echo '    <qresource prefix="/hologram">'
    for f in "$OUT"/*.webp "$OUT"/manifest.json "$OUT"/manifest.js; do
        echo "        <file alias=\"$(basename "$f")\">$(basename "$f")</file>"
    done
    echo '    </qresource>'
    echo '</RCC>'
} > "$OUT/hologram.qrc"

du -ch "$OUT"/*.webp "$OUT"/manifest.js | tail -1
